# Multi-Agent E-Commerce System Environment Variables
# Copy this file to .env and fill in the values

ECOM_LLM_API_KEY=
ECOM_LLM_BASE_URL=https://api.deepseek.com
ECOM_LLM_MODEL=deepseek-v4-flash
ECOM_REDIS_URL=redis://localhost:6379/0
ECOM_MILVUS_HOST=localhost
ECOM_MILVUS_PORT=19530
ECOM_MILVUS_COLLECTION=product_embeddings
ECOM_DATABASE_URL=sqlite:///./ecommerce.db
ECOM_EMBEDDING_API_KEY=
ECOM_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
ECOM_EMBEDDING_MODEL=Pro/BAAI/bge-m3
ECOM_EMBEDDING_DIMENSION=1024
ECOM_AB_TEST_ENABLED=true
ECOM_AB_TEST_DEFAULT_BUCKET_COUNT=100
